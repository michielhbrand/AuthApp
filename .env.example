# Cloud project values: Project URL + Publishable key from the Supabase Connect dialog.
# For local development, use the API URL + publishable key printed by `npm run supabase:status`.
#
# The publishable key is safe to ship in a browser bundle. Never put a Supabase
# secret key (sb_secret_...) or a legacy service_role key in a VITE_ variable.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
